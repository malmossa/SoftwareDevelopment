<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NumberGuessingGame.MainPage"
             BackgroundImageSource="background.png" >

  <VerticalStackLayout
      Padding="30"
      Spacing="15"
      HorizontalOptions="Center" >

      <!-- Header -->
      <VerticalStackLayout
        Spacing="0">
        <!-- Logo -->
        <Image
          Source="logo.png"
          WidthRequest="150"
          HeightRequest="150"
          Aspect="AspectFit" />

        <!-- Title -->
        <Label
          FontSize="32"
          FontAttributes="Bold"
          HorizontalTextAlignment="Center">

          <Label.FormattedText>
            <FormattedString>
              <Span Text="Number Guessing " TextColor="White" />
              <Span Text="Game" TextColor="#B8F34B" />
            </FormattedString>
          </Label.FormattedText>

        </Label>

      </VerticalStackLayout>

        <!-- Instructions -->
        <Label
          Text="I'm thinking of a number between 1 and 100. Can you guess it?"
          FontSize="18"
          TextColor="White"
          HorizontalTextAlignment="Center" />

        <!-- Input Section -->
        <HorizontalStackLayout
          Spacing="15">
          <Border
            Stroke="White"
            StrokeThickness="1"
            BackgroundColor="#245B51"
            Padding="10,0">

            <Border.StrokeShape>
              <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <Entry
              x:Name="GuessEntry"
              Placeholder="Enter your guess"
              Keyboard="Numeric"
              HorizontalTextAlignment="Center"
              FontSize="20"
              TextColor="White"
              PlaceholderColor="LightGray"
              BackgroundColor="#003D32"
              WidthRequest="250" />

          </Border>
          <Button />

        </HorizontalStackLayout>

  </VerticalStackLayout>

</ContentPage>
